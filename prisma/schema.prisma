generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BlacklistedToken {
    id        String   @id @default(uuid())
    token     String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())
}

model User {
    id String @id @default(uuid())
    email String @unique
    username String @unique
    password String
    role Role @default(Admin)

    kandidat Kandidat[]
}

enum Role {
  Admin
  SuperAdmin
}

model Otp {
    id String @id @default(uuid())
    email String
    code String
    type String
    metadata String
    expiresAt DateTime
    createdAt DateTime
}

model Kandidat {
    id              String   @id @default(uuid())
    kodeRegistrasi String? @unique
    userId String?
    nama String
    tinggi Float
    berat_badan Float
    umur Int
    tgllahir DateTime
    status Status @default(DRAFT)
    tujuan String?
    ojk StatusOJK @default(BELUM)
    pendidikan String 
    asal String
    bidang_pekerjaan String?
    pic String?
    keterangan String?
    telephone String?
    dana Dana?

    kelasJepangId String?
    kelasInggrisId String?

    // calon pmi
    biayaPelatihan PembayaranPelatihan @default(BELUM)
    suratPernyataan SuratPernyataan @default(BELUM)

    cvUrl           String
    kkUrl           String
    ktpUrl          String
    ktp_pendampingUrl     String
    ijazahUrl       String?
    sertifikatUrl   String?

    cvPublicId      String
    kkPublicId      String
    ktpPublicId     String
    ktp_pendampingPublicId String
    ijazahPublicId  String?
    sertifikatPublicId String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User? @relation(fields: [userId], references: [id])

    kelasJepang KelasJepang? @relation(fields: [kelasJepangId], references: [id])
    kelasInggris KelasInggris? @relation(fields: [kelasInggrisId], references: [id])
}

enum Status {
  DRAFT
  TERVERIFIKASI
  PERBAIKAN
}

enum StatusOJK {
  BELUM
  CHECKING
  LOLOS
  TIDAK_LOLOS
  MANDIRI
}

enum Dana {
  MANDIRI
  TALANG
}

enum PembayaranPelatihan {
  BELUM
  DP
  BULAN_1
  BULAN_2
  BULAN_3
  BULAN_4
  LUNAS
}

enum SuratPernyataan {
  SUDAH
  BELUM
}

model KelasJepang {
  id String @id @default(uuid())
  deskripsi String

  kandidat Kandidat[]
}

model KelasInggris {
  id String @id @default(uuid())
  deskripsi String

  kandidat Kandidat[]
}